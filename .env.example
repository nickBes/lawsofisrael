# Copy this file to `.env` and fill in your values. `.env` is gitignored.

# --- OpenAI-compatible API credentials ----------------------------------
# Required. For Gemini: https://aistudio.google.com/apikey
OPENAI_API_KEY=

# --- LLM configuration --------------------------------------------------
# Optional: override defaults if needed
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.5-flash

# Token budgets (used for chunking and output limits)
# MAX_CONTEXT_TOKENS=1048576
# MAX_OUTPUT_TOKENS=8192

# Rate limiting (requests per minute)
# RATE_LIMIT_RPM=15

# --- Local embedding server (scripts/start_embedding_server.sh) --------
# EMBEDDING_HOST=http://localhost
# EMBEDDING_PORT=8081
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_API_KEY=sk-local-embedding-key

# Copy this file to `.env` and fill in your values. `.env` is gitignored.

# --- OpenAI-compatible API credentials ----------------------------------
# Required. For Gemini: https://aistudio.google.com/apikey
OPENAI_API_KEY=

# --- LLM configuration --------------------------------------------------
# Optional: override defaults if needed
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.5-flash

# Token budgets (used for chunking and output limits)
# MAX_CONTEXT_TOKENS=1048576
# MAX_OUTPUT_TOKENS=8192

# Rate limiting (requests per minute)
# RATE_LIMIT_RPM=15

# --- Local embedding server (scripts/start_embedding_server.sh) --------
# EMBEDDING_HOST=http://localhost
# EMBEDDING_PORT=8081
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_API_KEY=sk-local-embedding-key

# --- Remote (API) embedding model, optional -----------------------------
# Alternative embedding backend for the v2.1 diagnostics (EMBED_BACKEND='gemini'
# in the notebook). Served by the same OpenAI-compatible provider as the chat
# model. NOTE: this sends bullet text to the third-party API. The exact model id
# may change while in preview; override here if needed.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
# Optional Matryoshka output dimensionality (blank = provider default; Gemini
# recommends 3072, 1536, or 768).
# GEMINI_EMBEDDING_DIM=
# Defaults to OPENAI_BASE_URL / OPENAI_API_KEY if unset.
# GEMINI_EMBEDDING_BASE_URL=
# GEMINI_EMBEDDING_API_KEY=
